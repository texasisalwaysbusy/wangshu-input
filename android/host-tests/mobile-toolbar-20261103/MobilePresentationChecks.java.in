package org.wangshu.ime;

import java.util.*;

/** Production bodies/fragments are inserted by run.py; Android views are fakes. */
public final class MobilePresentationChecks {
    static class Node {
        final List<Node> children=new ArrayList<>();
        String text="",description="",tooltip="",skin="";
        boolean enabled=true;int options=-1,minWidth,minimumWidth;
        Runnable click=()->{},longClick=()->{};Object params;
        void addView(Node n){children.add(n);}void addView(Node n,Object p){n.params=p;children.add(n);}
        void removeAllViews(){children.clear();}
        void setText(String x){text=x;}void setAllCaps(boolean x){}void setTextSize(int x){}
        void setMaxLines(int x){}void setHorizontallyScrolling(boolean x){}
        void setAutoSizeTextTypeUniformWithConfiguration(int a,int b,int c,int d){}
        void setAutoSizeTextTypeWithDefaults(int x){}void setTextColor(int x){}
        void setMinWidth(int x){minWidth=x;}void setMinimumWidth(int x){minimumWidth=x;}
        void setPadding(int a,int b,int c,int d){}
        void setContentDescription(String x){description=x;}void setTooltipText(String x){tooltip=x;}
        void setEnabled(boolean x){enabled=x;}
        interface Listener{void run(Node node);}
        void setOnClickListener(Listener listener){click=()->listener.run(this);}
        interface LongListener{boolean run(Node node);}
        void setOnLongClickListener(LongListener listener){longClick=()->listener.run(this);}
        void press(){if(enabled)click.run();}
    }
    static class Button extends Node {Button(Object ignored){}}
    static class GlyphKey extends Button {GlyphKey(Object ignored){super(ignored);}}
    static class ImageButton extends Button {ToolbarIcon.Kind icon;ImageButton(Object ignored){super(ignored);}}
    static class TextView {static final int AUTO_SIZE_TEXT_TYPE_NONE=0;}
    static class LinearLayout extends Node {
        static class LayoutParams {int width,height;float weight;
            LayoutParams(int w,int h){width=w;height=h;}LayoutParams(int w,int h,float x){this(w,h);weight=x;}}
    }
    static class ScrollView extends Node {ScrollView(Object ignored){}}
    static class Space extends Node {Space(Object ignored){}}
    static class ToolbarIcon {/*EXTRACT_ICON_ENUM*/}
    static class KeyboardSkin {
        static void key(Object ignored,Node b,boolean selected){b.skin="key";}
        static void function(Object ignored,Node b,boolean selected){b.skin="function";}
    }
    static class android {static class util {static class TypedValue {static final int COMPLEX_UNIT_SP=2;}}}
    static class R {static class color {static final int ink=0;}}
    static class BuildConfig {static boolean BASIC_TYPING_PREVIEW;}
    static class PreviewFeatures {static final String VOICE_UNAVAILABLE="preview voice unavailable";}
    static class SettingsActivity {}
    static class Intent {static final int FLAG_ACTIVITY_NEW_TASK=0x10000000;Class<?> target;int flags;
        Intent(Object ignored,Class<?> type){target=type;}Intent addFlags(int x){flags|=x;return this;}}
    static class Surface {Button space;void spaceKey(Button b){space=b;}}
    static class Before {void invalidate(){}}
    static class PersonalPanel {void open(){}}
    static class DataFiles {static boolean ready=true;}
    boolean math,numbers,english,password,phrasesOpen,editing,isCompact,finish=true,currentPageFuzzy;
    int inputSession;long emojiViewGeneration;Object inputOwner=new Object();Object getCurrentInputConnection(){return inputOwner;}
    int position,page,chosen=-1,longPressed=-1,rebuilds,refreshes,voiceStarts,hides;
    Object offlineTask,recognizer;Intent launched;
    LinearLayout root=new LinearLayout(),keys=new LinearLayout(),candidates=new LinearLayout(),toolbar;
    ImageButton voiceButton,hideButton;Surface inputSurface=new Surface();Before beforeCaret=new Before();
    PersonalPanel personalPanel=new PersonalPanel();StringBuilder buffer=new StringBuilder("test");
    String[] current=new String[0];String[][] pages={new String[0]};
    class Pref {int getInt(String key,int fallback){return position;}}
    Pref getSharedPreferences(String name,int mode){return new Pref();}
    int dp(int n){return n;}boolean compact(){return isCompact;}int keyHeight(){return isCompact?36:48;}
    int candidateTextSizeSp(){return isCompact?18:20;}int getColor(int color){return color;}
    LinearLayout row(){return new LinearLayout();}LinearLayout column(){return new LinearLayout();}
    void cancelBackspace(){}void cancelHoldForOtherInput(){}boolean finishRaw(){return finish;}
    void rebuild(){rebuilds++;}void refresh(){refreshes++;}void space(){}void enter(){}
    void punctuation(char ch){}void key(String text){buffer.append(text);}void toast(String text){}
    void captureClipboard(boolean requested){}void startVoice(){voiceStarts++;}
    void requestHideSelf(int flags){hides++;}void startActivity(Intent intent){launched=intent;}
    ImageButton cursorButton(){ImageButton b=new ImageButton(this);b.description="光标与文本编辑";return b;}
    ImageButton tool(LinearLayout parent,ToolbarIcon.Kind icon,String name,String help,float weight,boolean selected,Runnable action){
        ImageButton b=new ImageButton(this);b.icon=icon;b.description=name;b.tooltip=help;b.click=action;
        parent.addView(b,new LinearLayout.LayoutParams(0,48,weight));return b;
    }
    void add(LinearLayout row,String value,float weight,Runnable action){row.addView(button(value,action),new LinearLayout.LayoutParams(0,dp(keyHeight()),weight));}
    void addBackspace(LinearLayout row,float weight){add(row,"⌫",weight,()->{});}
    Runnable displayedCandidate(int index){return ()->chosen=index;}
    void bindCandidateOptions(Button button,int index){button.options=index;button.longClick=()->longPressed=index;}
    String[] lookup(String input,int requestedPage){return requestedPage>=0&&requestedPage<pages.length?pages[requestedPage]:new String[0];}

    /*EXTRACT_FUNCTION*/
    /*EXTRACT_BUTTON*/
    /*EXTRACT_CANDIDATE_BUTTON*/
    void renderStrip(){/*EXTRACT_STRIP*/}
    /*EXTRACT_EXPANDED*/
    /*EXTRACT_BOTTOM*/
